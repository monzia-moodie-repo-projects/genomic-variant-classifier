# Default text normalization.
* text=auto

# Repository metadata.
.gitattributes text eol=lf
.gitignore text eol=lf
*.gitignore text eol=lf

# Source/config/docs: force LF across platforms.
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.lock text eol=lf

# Shell scripts run on Linux VMs.
*.sh text eol=lf

# Windows-native scripts.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary/data artifacts: never normalize.
*.gz binary
*.zip binary
*.sqlite binary
*.db binary
*.pkl binary
*.joblib binary
*.parquet binary
*.feather binary
*.npy binary
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary

# ---------------------------------------------------------------------------
# TEST FIXTURES: byte-stable across platforms (added 2026-07-12).
# ---------------------------------------------------------------------------
# A fixture's entire purpose is to be a FIXED, reproducible input. If git normalizes it,
# the file a Linux Continuous Integration runner reads is NOT the file a Windows developer
# reads, and a test can pass on one and fail on the other for reasons nothing in the test
# explains.
#
# Observed 2026-07-12: tests/fixtures/alphafold/AF-E7ENB7-F1-model_v4.cif was committed as a
# 99,647-byte blob while the working copy was 101,171 bytes -- exactly 1,524 carriage returns
# stripped, one per line (`git show --stat` reported it as "1524 ++++", i.e. git had decided
# it was text). Benign in this instance, because the mmCIF parser is line-ending-agnostic and
# the tests passed on both platforms. But the carriage returns were themselves an ACCIDENT:
# Python's write_text() runs in TEXT mode on Windows, so the connector's download cache
# translated \n -> \r\n on the way to disk. LF is the canonical form, as served by the
# European Bioinformatics Institute.
#
# Pin it. Never leave a fixture's byte-level encoding to inference -- and note that had this
# fixture been genuinely binary (a parquet, an .npy), normalization would have SILENTLY
# CORRUPTED it rather than merely shortening it.
tests/fixtures/**/*.cif text eol=lf

# Binary fixtures: verbatim, always. Normalization would destroy them.
tests/fixtures/**/*.parquet binary
tests/fixtures/**/*.npy     binary
tests/fixtures/**/*.npz     binary
tests/fixtures/**/*.gz      binary
tests/fixtures/**/*.sqlite  binary

# No file extension, so only the 'text=auto' default matched it -- and that means
# CRLF in a Windows working tree. Every other governed text file has eol=lf. 2026-07-18.
EXPECTED_SUITE_SIZE text eol=lf

# ---------------------------------------------------------------------------
# REPOSITORY RECORDS: durable machine evidence (ADR-0004, added 2026-08-22).
# ---------------------------------------------------------------------------
# `records/` holds facts EMITTED about what happened, not documentation about
# it. Authored metadata under the plane is normalised like every other governed
# text file. PRESERVED artifacts are not: their entire claim is that their
# bytes are exactly the bytes that existed, and an artifact git has
# "helpfully" rewritten is no longer evidence of anything.
#
# ORDER IS LOAD-BEARING. Later rules win. `*.json text eol=lf` on line 11
# already matches every path below, so the `-text` rule must come AFTER the
# general records rules, not before. Measured 2026-08-22: the eleven install
# attestations are line-feed-only today, so normalisation is currently a
# no-op FOR THEM -- which is precisely why the rule must not depend on the
# corpus staying friendly. RECORDS-EOL-NORMALIZATION-1.
records/**/*.json text eol=lf
records/**/*.md text eol=lf
records/**/*.yaml text eol=lf
records/attestations/installations/artifacts/** -text
