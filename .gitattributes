# Default text normalization.
* text=auto

# Repository metadata.
.gitattributes text eol=lf
.gitignore text eol=lf
*.gitignore text eol=lf

# Source/config/docs: force LF across platforms.
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.lock text eol=lf

# Shell scripts run on Linux VMs.
*.sh text eol=lf

# Windows-native scripts.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary/data artifacts: never normalize.
*.gz binary
*.zip binary
*.sqlite binary
*.db binary
*.pkl binary
*.joblib binary
*.parquet binary
*.feather binary
*.npy binary
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
